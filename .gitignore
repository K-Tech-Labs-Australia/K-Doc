# Dependencies
node_modules/
.pnp/
.pnp.js

# Build output
dist/
build/
out/
*.tsbuildinfo

# Rust / Tauri
src-tauri/target/
# Second target dir used for mutation runs while the app holds a lock on target/debug.
src-tauri/target-mut/
# The same dir when cargo is run from the repo root with --manifest-path.
target-mut/
src-tauri/gen/

# Test / coverage
coverage/
.vitest/
*.lcov

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Orchestrator scratch
.orchestrator/

# K-Doc local annotation store (see docs/internal/PRELIM-SPEC.md FR-6.20)
.k-doc/local/

# Env
.env
.env.local

# Hunspell dictionaries. A 552 KB third-party asset; whether it belongs in the repository
# is the repository owner's call, so `npm run fetch-dictionary` pulls it instead.
packages/app/public/dictionaries/
# Generated by `npm run notices` before every release build.
packages/app/public/THIRD-PARTY-NOTICES.txt

# Stray compiler output. tsc emits JavaScript beside the TypeScript it compiled unless it is told
# not to, and a cargo invocation outside src-tauri leaves .rmeta files at whatever directory it ran
# in. Neither is source, and both turn up in `git status` looking like work.
*.rmeta
packages/*/src/**/*.js

# Agent tooling kept on the maintainer's disk, never published
.claude/
GEMINI.md

# Logs, local env files and stray build output
*.log
.env.*
/target/
